# PoC 测试包和原始结果统一放在该目录，只在本地保存
/artifacts/poc/

# 多 Agent 和长任务的详细临时证据，不作为长期事实源
/artifacts/runtime/

# 项目 Python 虚拟环境
/.vevn/

# 本地运行数据、环境文件和可编辑安装元数据
/data/
/build/
/.env
*.egg-info/

# PoC 本地依赖、缓存与构建产物
**/__pycache__/
*.py[cod]
/poc/candidate-b/node_modules/
/poc/candidate-b/storage/
/poc/candidate-b/dist/
