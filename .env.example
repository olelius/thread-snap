# 进程与持久化目录
THREADSNAP_DATABASE_URL=sqlite:///./data/threadsnap.db
THREADSNAP_DATA_DIR=data
THREADSNAP_TIMEZONE=Asia/Shanghai

# 后台协调器轮询周期
THREADSNAP_SCHEDULER_POLL_SECONDS=15
THREADSNAP_WORKER_POLL_SECONDS=1
THREADSNAP_START_BACKGROUND_SERVICES=true

# 第一版后端固定只同时运行一个平台；该值不向前端开放
THREADSNAP_PLATFORM_LEVEL_CONCURRENCY=1

# 部署环境应单独提供 Fernet 密钥；留空时本地自动生成 data/session.key
# THREADSNAP_SESSION_FERNET_KEY=

# 目标平台当前要求完整有头 Chromium；Linux 通过 Weston 提供无头 Wayland 显示
THREADSNAP_AUTH_BROWSER_HEADLESS=false

# 口碑合成验收必须同时满足 test 模式、显式能力开关和隔离测试库标记。
# 生产环境保持以下默认值；本地验收应改用独立数据库路径。
THREADSNAP_RUNTIME_MODE=production
THREADSNAP_ENABLE_REPUTATION_SYNTHETIC_RUNS=false
THREADSNAP_REPUTATION_TEST_DATABASE=false
