# 该文件由 install.sh 生成正式副本；尖括号变量会在安装时替换。
THREADSNAP_DATABASE_URL=sqlite:////var/lib/threadsnap/threadsnap.db
THREADSNAP_DATA_DIR=/var/lib/threadsnap
THREADSNAP_TIMEZONE=Asia/Shanghai

THREADSNAP_SCHEDULER_POLL_SECONDS=15
THREADSNAP_WORKER_POLL_SECONDS=1
THREADSNAP_START_BACKGROUND_SERVICES=true
THREADSNAP_PLATFORM_LEVEL_CONCURRENCY=1

# 首次安装由 install.sh 生成；升级必须沿用原值。
THREADSNAP_SESSION_FERNET_KEY=<FERNET_KEY>

# 当前目标平台的认证页在无头模式返回零字节文档，Linux 必须使用 Xvfb。
THREADSNAP_AUTH_BROWSER_HEADLESS=false
PLAYWRIGHT_BROWSERS_PATH=/opt/threadsnap/browsers
DISPLAY=:99
