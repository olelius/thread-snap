[Unit]
Description=ThreadSnap virtual X display
After=local-fs.target

[Service]
Type=simple
User=threadsnap
Group=threadsnap
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp -noreset
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
